# Copy to .env.local for local dev. Real values live only in Vercel environment variables.
# Never commit real secrets.

# Postgres (Neon). Local dev: postgresql://postgres:postgres@localhost:5432/hours_tracker
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"
# Entra ID sign-in app registration (delegated). Issuer pins sign-in to the company tenant.
AUTH_MICROSOFT_ENTRA_ID_ID="00000000-0000-0000-0000-000000000000"
AUTH_MICROSOFT_ENTRA_ID_SECRET="replace-me"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0"
# Only emails at this domain can sign in (in addition to the User allow-list).
ALLOWED_EMAIL_DOMAIN="esquireinteractive.com"

# Minute7 (Phase 3). Prefer the long-lived token from My Settings.
MINUTE7_API_TOKEN=""
MINUTE7_EMAIL=""
MINUTE7_PASSWORD=""

# Microsoft Graph Mail.Send app registration (Phase 6), restricted to one mailbox.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
REPORTS_MAILBOX="reports@esquireinteractive.com"

# Zoho Projects (Phase 5, optional)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_PORTAL_ID=""

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="replace-me"
# 32-byte key, base64, for encrypting the cached Minute7 session token
ENCRYPTION_KEY="replace-me"
